+    # corresponding sing-box build tag. Unknown builds fail closed.
+    if LC_ALL=C grep -aFq 'with_tailscale' "$_bin" 2>/dev/null; then
         printf '%s 1\n' "$_key" > "$TSNET_CAP_CACHE"
         return 0
     fi
