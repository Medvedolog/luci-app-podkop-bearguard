#!/bin/sh /etc/rc.common
# OpenWrt Bearhole HWELP proxy service.

START=97
STOP=15
USE_PROCD=1

BH_CTL=/usr/lib/podkop_bot/bearhole.sh
BH_PROXY=/usr/bin/podkop-bearhole-proxy
BH_ROUTES=/tmp/podkop_bot/bearhole/routes.conf

engine_ready() {
    [ -x /usr/bin/ucode ] || return 1
    [ -x "$BH_PROXY" ] || return 1
    /usr/bin/ucode "$BH_PROXY" --check >/dev/null 2>&1
}

start_service() {
    local enabled

    # procd owns only the standalone HWELP process. The Bearhole control plane
    # decides when it is safe to apply the global system proxy and when to run
    # route qualification. Keeping that sequencing in one place avoids races
    # between rc.common/procd startup and the rpcd worker.
    "$BH_CTL" system-off >/dev/null 2>&1 || true

    enabled="$(uci -q get podkop_bearhole.main.enabled 2>/dev/null)"
    [ "$enabled" = 1 ] || return 0

    if ! engine_ready; then
        logger -t podkop-bearhole 'event=engine_unavailable action=start_skipped' 2>/dev/null || true
        return 0
    fi

    if ! "$BH_CTL" bootstrap >/dev/null 2>&1; then
        logger -t podkop-bearhole 'event=no_routes action=start_skipped' 2>/dev/null || true
        return 0
    fi

    procd_open_instance
    procd_set_param command /usr/bin/ucode "$BH_PROXY" -l 127.0.0.1 -p 1066 -c "$BH_ROUTES"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Never leave curl/wget/opkg/environment pointing at a stopped HWELP proxy.
    "$BH_CTL" system-off >/dev/null 2>&1 || true
}

reload_service() {
    # Update the helper's route file. A full fresh qualification is owned by
    # the Bearhole control plane, not by the init script.
    "$BH_CTL" bootstrap >/dev/null 2>&1 || true
}

service_triggers() {
    procd_add_reload_trigger podkop_bearhole
}
