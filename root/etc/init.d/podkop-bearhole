#!/bin/sh /etc/rc.common
# OpenWrt Bearhole HWELP proxy service.

START=97
STOP=15
USE_PROCD=1

BH_CTL=/usr/lib/podkop_bot/bearhole.sh
BH_PROXY=/usr/bin/hwelp-proxy
BH_ROUTES=/tmp/podkop_bot/bearhole/routes.conf

engine_ready() {
    [ -x "$BH_PROXY" ] || return 1
    "$BH_PROXY" --check >/dev/null 2>&1
}

hwelp_port() {
    local port
    port="$(uci -q get podkop_bearhole.main.port 2>/dev/null)"
    case "$port" in ''|*[!0-9]*) port=1066;; esac
    [ "$port" -ge 1024 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || port=1066
    printf '%s' "$port"
}

start_service() {
    local enabled port

    # procd owns only the native HWELP process. The Bearhole control plane
    # decides when it is safe to apply the global system proxy and qualification.
    "$BH_CTL" system-off >/dev/null 2>&1 || true

    enabled="$(uci -q get podkop_bearhole.main.enabled 2>/dev/null)"
    [ "$enabled" = 1 ] || return 0

    if ! engine_ready; then
        logger -t podkop-bearhole 'event=engine_unavailable action=start_skipped' 2>/dev/null || true
        return 0
    fi

    if ! "$BH_CTL" bootstrap >/dev/null 2>&1; then
        logger -t podkop-bearhole 'event=no_routes action=start_skipped' 2>/dev/null || true
        return 0
    fi

    port="$(hwelp_port)"
    procd_open_instance
    procd_set_param command "$BH_PROXY" -l 127.0.0.1 -p "$port" -c "$BH_ROUTES"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Never leave curl/wget/opkg/environment pointing at a stopped HWELP proxy.
    "$BH_CTL" system-off >/dev/null 2>&1 || true
}

reload_service() {
    "$BH_CTL" bootstrap >/dev/null 2>&1 || true
}

service_triggers() {
    procd_add_reload_trigger podkop_bearhole
}
