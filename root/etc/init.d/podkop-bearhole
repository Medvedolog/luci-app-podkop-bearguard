#!/bin/sh /etc/rc.common
# OpenWrt Bearhole system proxy service.

START=97
STOP=15
USE_PROCD=1

BH_CTL=/usr/lib/podkop_bot/bearhole.sh
BH_PROXY=/usr/bin/podkop-bearhole-proxy
BH_ROUTES=/tmp/podkop_bot/bearhole/routes.conf

engine_ready() {
    [ -x /usr/bin/ucode ] || return 1
    [ -x "$BH_PROXY" ] || return 1
    /usr/bin/ucode "$BH_PROXY" --check >/dev/null 2>&1
}

start_service() {
    local enabled pid i

    # Fail closed after a crash/partial upgrade: never leave system tools
    # pointing at 127.0.0.1:1066 until a live gateway has been confirmed.
    "$BH_CTL" system-off >/dev/null 2>&1 || true

    enabled="$(uci -q get podkop_bearhole.main.enabled 2>/dev/null)"
    [ "$enabled" = 1 ] || return 0

    if ! engine_ready; then
        logger -t podkop-bearhole 'event=engine_unavailable action=start_skipped' 2>/dev/null || true
        return 0
    fi

    if ! "$BH_CTL" bootstrap >/dev/null 2>&1; then
        logger -t podkop-bearhole 'event=no_routes action=start_skipped' 2>/dev/null || true
        return 0
    fi

    procd_open_instance
    procd_set_param command /usr/bin/ucode "$BH_PROXY" -l 127.0.0.1 -p 1066 -c "$BH_ROUTES"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # procd_close_instance() normally starts the process immediately. Give it a
    # bounded window and only then apply the global system proxy switch.
    i=0
    while [ "$i" -lt 5 ]; do
        pid=$(ubus call service list '{"name":"podkop-bearhole"}' 2>/dev/null | jq -r '.["podkop-bearhole"].instances[]?.pid // 0' 2>/dev/null | head -n1)
        case "$pid" in ''|*[!0-9]*) pid=0;; esac
        if [ "$pid" -gt 0 ] 2>/dev/null && kill -0 "$pid" 2>/dev/null; then
            "$BH_CTL" system-on >/dev/null 2>&1 || {
                logger -t podkop-bearhole 'event=system_proxy_apply_failed' 2>/dev/null || true
                return 0
            }
            "$BH_CTL" qualify-start >/dev/null 2>&1 || true
            return 0
        fi
        sleep 1
        i=$((i+1))
    done

    "$BH_CTL" system-off >/dev/null 2>&1 || true
    logger -t podkop-bearhole 'event=gateway_start_failed system_proxy=off' 2>/dev/null || true
}

stop_service() {
    # Never leave curl/wget/opkg/environment pointing at a stopped 1066
    # listener. restart_service() will re-apply the proxy only after confirming
    # that the standalone gateway is live.
    "$BH_CTL" system-off >/dev/null 2>&1 || true
}

reload_service() {
    "$BH_CTL" bootstrap >/dev/null 2>&1 || true
    "$BH_CTL" qualify-start >/dev/null 2>&1 || true
}

service_triggers() {
    procd_add_reload_trigger podkop_bearhole
}
