#!/bin/sh /etc/rc.common

START=100
STOP=15
USE_PROCD=1

PROG=/usr/lib/podkop_bot/tsnet-overlay-watch.sh
STATE=/etc/podkop-bot/tsnet.json

start_service() {
    [ -x "$PROG" ] || return 0
    [ -r "$STATE" ] || return 0
    [ "$(jq -r '.enabled // false' "$STATE" 2>/dev/null)" = true ] || return 0

    provider=$(jq -r '.provider // ""' "$STATE" 2>/dev/null)
    case "$provider" in
        podkop|forkop-x) ;;
        *) return 0 ;;
    esac

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 0
    procd_set_param stderr 0
    procd_set_param file "$STATE"
    procd_close_instance
}

reload_service() {
    stop
    start
}
