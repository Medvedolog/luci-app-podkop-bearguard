#!/bin/sh
# rpcd exec plugin for advisory Telegram Bot API route qualification.
# Transport routes are resolved by the existing podkop_bot transport_state and
# runtime_sections RPCs. WARPSCOUT remains owner of WARP discovery/ranking; this
# worker only qualifies configured routes and never mutates POLL/FAST state.

BIN="/usr/bin/warpscout"
STATE_DIR="/tmp/podkop_bot"
PERSIST_DIR="/etc/podkop_bot"
CONFIG_FILE="$PERSIST_DIR/warpscout.conf"
ACCOUNT_FILE="$PERSIST_DIR/warpscout-account.json"
SHORTLIST_FILE="$PERSIST_DIR/warpscout-shortlist.tsv"
RUNTIME_PID_FILE="$STATE_DIR/warpscout_socks.pid"
RESCUE_PID_FILE="$STATE_DIR/warpscout_rescue_socks.pid"
ACTION_PID_FILE="$STATE_DIR/warpscout_action.pid"

SCAN_STATE="$STATE_DIR/warpscout_tgscan.state"
SCAN_PID="$STATE_DIR/warpscout_tgscan.pid"
SCAN_LOG="$STATE_DIR/warpscout_tgscan.log"
SCAN_RESULTS="$STATE_DIR/warpscout_tgscan.results"
SCAN_INPUT="$STATE_DIR/warpscout_tgscan.input"
SCAN_SOCKS_PID="$STATE_DIR/warpscout_tgscan_socks.pid"

mkdir -p "$STATE_DIR" 2>/dev/null

json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n\r\t' '   '; }
json_str() { printf '"%s"' "$(json_escape "$1")"; }
cfg_get() { [ -f "$CONFIG_FILE" ] && sed -n "s/^$1=//p" "$CONFIG_FILE" | head -n1; }
valid_endpoint() { printf '%s' "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{1,5}$'; }
mask_proxy() { printf '%s' "$1" | sed -E 's|(://[^:@/]+:)[^@/]*@|\1***@|'; }
section_id() {
	_s=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9_]+/_/g; s/^_+//; s/_+$//')
	[ -n "$_s" ] || _s=route
	printf 'section_%s' "$_s"
}

pid_from_file() {
	_pf="$1"; [ -s "$_pf" ] || return 1
	_p=$(cat "$_pf" 2>/dev/null)
	case "$_p" in ''|*[!0-9]*) return 1;; esac
	printf '%s' "$_p"
}
pid_alive_file() { _p=$(pid_from_file "$1") || return 1; kill -0 "$_p" 2>/dev/null; }

state_write() {
	_state="$1"; _current="$2"; _total="$3"; _route="$4"; _phase="$5"; _valid="$6"; _reachable="$7"; _failed="$8"; _started="$9"
	_route=$(mask_proxy "$_route")
	_now=$(date +%s 2>/dev/null || echo 0); _tmp="$SCAN_STATE.$$"
	{
		printf 'state=%s\n' "$_state"
		printf 'current=%s\n' "$_current"
		printf 'total=%s\n' "$_total"
		printf 'endpoint=%s\n' "$_route"
		printf 'phase=%s\n' "$_phase"
		printf 'passed=%s\n' "$_valid"
		printf 'reachable=%s\n' "$_reachable"
		printf 'failed=%s\n' "$_failed"
		printf 'started_at=%s\n' "$_started"
		printf 'updated_at=%s\n' "$_now"
	} > "$_tmp" && mv "$_tmp" "$SCAN_STATE"
}
state_get() { [ -s "$SCAN_STATE" ] && sed -n "s/^$1=//p" "$SCAN_STATE" | head -n1; }

stop_scan_socks() {
	if _p=$(pid_from_file "$SCAN_SOCKS_PID"); then
		kill "$_p" 2>/dev/null || true
		_i=0
		while kill -0 "$_p" 2>/dev/null && [ "$_i" -lt 20 ]; do sleep 0.1; _i=$((_i+1)); done
		kill -9 "$_p" 2>/dev/null || true
	fi
	rm -f "$SCAN_SOCKS_PID" 2>/dev/null
}

append_result() {
	_line="$1"; _tmp="$SCAN_RESULTS.$$"
	if [ -s "$SCAN_RESULTS" ]; then cat "$SCAN_RESULTS" > "$_tmp"; else : > "$_tmp"; fi
	printf '%s\n' "$_line" >> "$_tmp" && mv "$_tmp" "$SCAN_RESULTS"
}

probe_telegram() {
	_proxy="$1"; _token="$2"
	_body="$STATE_DIR/tgroute_body.$$"; _err="$STATE_DIR/tgroute_error.$$"
	_t0=$(date +%s%3N 2>/dev/null); case "$_t0" in ''|*[!0-9]*) _t0=$(( $(date +%s 2>/dev/null || echo 0) * 1000 ));; esac
	_http=$(curl -sS -o "$_body" -w '%{http_code}' --proxy "$_proxy" --connect-timeout 5 --max-time 12 "https://api.telegram.org/bot${_token}/getMe" 2>"$_err")
	_rc=$?
	_t1=$(date +%s%3N 2>/dev/null); case "$_t1" in ''|*[!0-9]*) _t1=$(( $(date +%s 2>/dev/null || echo 0) * 1000 ));; esac
	_ms=$((_t1-_t0)); [ "$_ms" -lt 0 ] 2>/dev/null && _ms=0
	_errtxt=$(head -c 240 "$_err" 2>/dev/null | tr '\n\r\t|' '    ')
	[ -n "$_token" ] && _errtxt=$(printf '%s' "$_errtxt" | sed "s/${_token}/<redacted>/g")
	_status=FAIL; _reason="curl_error_${_rc}"
	if [ "$_rc" -eq 28 ]; then
		_http=000
		case "$_errtxt" in *[Cc]onnection\ timed\ out*) _reason=connect_timeout;; *) _reason=request_timeout;; esac
	elif [ "$_rc" -ne 0 ] || [ -z "$_http" ] || [ "$_http" = 000 ]; then
		_http=000
	elif [ "$_http" = 200 ] && jq -e '.ok == true' "$_body" >/dev/null 2>&1; then
		_status=VALID; _reason=ok
	elif [ "$_http" = 429 ]; then
		_status=REACHABLE_RATE_LIMITED; _reason=http_429
	elif [ "$_http" = 401 ]; then
		_status=REACHABLE_AUTH; _reason=http_401
	elif [ "$_http" = 403 ]; then
		_status=REACHABLE_DENIED; _reason=http_403
	else
		_status=FAIL; _reason="http_${_http}"
	fi
	rm -f "$_body" "$_err" 2>/dev/null
	printf '%s|%s|%s|%s|%s\n' "$_status" "$_reason" "$_http" "$_ms" "$_errtxt"
}

build_input() {
	_tmp="$SCAN_INPUT.$$"; : > "$_tmp"
	_ts=$(ubus call podkop_bot transport_state '{}' 2>/dev/null)
	if [ -n "$_ts" ]; then
		_t1=$(printf '%s' "$_ts" | jq -r 'if (.tier1.mixed_proxy_enabled == true) then (.tier1.endpoint // "") else "" end' 2>/dev/null)
		[ -n "$_t1" ] && printf 'proxy|tier1|Mixed Proxy|%s||||||\n' "$_t1" >> "$_tmp"
	fi

	# Mixed Proxy endpoints from every other runtime-capable Podkop/Forkop
	# section are first-class routes. Their IDs are derived from the UCI section
	# name, so fork-specific labels do not matter: backup -> section_backup.
	_rs=$(ubus call podkop_bot runtime_sections '{}' 2>/dev/null)
	if [ -n "$_rs" ]; then
		_primary=$(printf '%s' "$_rs" | jq -r '.primary_section // ""' 2>/dev/null)
		printf '%s' "$_rs" | jq -r --arg p "$_primary" '.sections[]? | select(.name != $p and .enabled_for_runtime == true and (.endpoint // "") != "") | [(.name // "route"), (.endpoint // "")] | @tsv' 2>/dev/null \
		| while IFS="	" read -r _name _ep; do
			[ -n "$_ep" ] || continue
			_sid=$(section_id "$_name")
			printf 'proxy|%s|Podkop section %s|%s||||||\n' "$_sid" "$_name" "$_ep"
		done >> "$_tmp"
	fi

	if [ -n "$_ts" ]; then
		_i=0
		printf '%s' "$_ts" | jq -r '.tier2_fallback_socks[]? // empty' 2>/dev/null | while IFS= read -r _fb; do
			[ -n "$_fb" ] || continue
			_i=$((_i+1)); printf 'proxy|tier2_%s|Reserve #%s|%s||||||\n' "$_i" "$_i" "$_fb"
		done >> "$_tmp"
		_t3=$(printf '%s' "$_ts" | jq -r '.tier3_custom_proxy // ""' 2>/dev/null)
		[ -n "$_t3" ] && printf 'proxy|tier3|Custom Proxy|%s||||||\n' "$_t3" >> "$_tmp"
	fi

	if [ -x "$BIN" ] && [ -s "$ACCOUNT_FILE" ] && [ -s "$SHORTLIST_FILE" ]; then
		_i=0
		while IFS='|' read -r _ep _epping _tunping _loss _seen _node _loc _checked; do
			valid_endpoint "$_ep" || continue
			_i=$((_i+1))
			printf 'warp|warpscout_%s|WARP #%s|%s|%s|%s|%s|%s|%s|%s\n' "$_i" "$_i" "$_ep" "$_epping" "$_tunping" "$_loss" "$_seen" "$_node" "$_loc" >> "$_tmp"
		done < "$SHORTLIST_FILE"
	fi
	_count=$(wc -l < "$_tmp" 2>/dev/null | tr -d ' ')
	case "$_count" in ''|0|*[!0-9]*) rm -f "$_tmp"; return 1;; esac
	mv "$_tmp" "$SCAN_INPUT" || { rm -f "$_tmp"; return 1; }
	printf '%s' "$_count"
}

worker_cancelled() {
	stop_scan_socks
	_cur=$(state_get current); _total=$(state_get total); _route=$(state_get endpoint); _valid=$(state_get passed); _reachable=$(state_get reachable); _failed=$(state_get failed); _started=$(state_get started_at)
	state_write cancelled "${_cur:-0}" "${_total:-0}" "$_route" cancelled "${_valid:-0}" "${_reachable:-0}" "${_failed:-0}" "${_started:-0}"
	echo "[tgroutes] cancelled"
	rm -f "$SCAN_PID" "$SCAN_INPUT" 2>/dev/null
	exit 143
}

run_worker() {
	_total="$1"; _port="$2"; _proto="$3"; _token="$4"; _started="$5"
	trap worker_cancelled TERM INT HUP
	_valid=0; _reachable=0; _failed=0; _idx=0
	while IFS='|' read -r _kind _source _label _target _epping _tunping _loss _seen _node _loc; do
		[ -n "$_target" ] || continue
		_idx=$((_idx+1)); _display=$(mask_proxy "$_target"); _proxy="$_target"
		if [ "$_kind" = warp ]; then
			state_write running "$_idx" "$_total" "$_label · $_target" tunnel_start "$_valid" "$_reachable" "$_failed" "$_started"
			echo "[tgroutes] ${_idx}/${_total} $_source $_target: starting WARP SOCKS"
			stop_scan_socks
			( exec "$BIN" socks -a "$ACCOUNT_FILE" -e "$_target" -p "$_proto" -l 127.0.0.1 -P "$_port" ) >> "$SCAN_LOG" 2>&1 &
			_spid=$!; printf '%s\n' "$_spid" > "$SCAN_SOCKS_PID"; sleep 3
			if ! kill -0 "$_spid" 2>/dev/null; then
				_now=$(date +%s 2>/dev/null || echo 0)
				append_result "$_kind|$_source|$_label|$_display|FAIL|socks_start_failed|000|0|$_now|$_epping|$_tunping|$_loss|$_seen|$_node|$_loc"
				_failed=$((_failed+1)); stop_scan_socks; continue
			fi
			_proxy="socks5h://127.0.0.1:$_port"
		else
			state_write running "$_idx" "$_total" "$_label" telegram_test "$_valid" "$_reachable" "$_failed" "$_started"
			echo "[tgroutes] ${_idx}/${_total} $_source: Telegram Bot API"
		fi
		state_write running "$_idx" "$_total" "$_label · $_display" telegram_test "$_valid" "$_reachable" "$_failed" "$_started"
		_probe=$(probe_telegram "$_proxy" "$_token")
		_status=$(printf '%s' "$_probe" | cut -d'|' -f1); _reason=$(printf '%s' "$_probe" | cut -d'|' -f2); _http=$(printf '%s' "$_probe" | cut -d'|' -f3); _ms=$(printf '%s' "$_probe" | cut -d'|' -f4); _detail=$(printf '%s' "$_probe" | cut -d'|' -f5-)
		_now=$(date +%s 2>/dev/null || echo 0)
		append_result "$_kind|$_source|$_label|$_display|$_status|$_reason|$_http|$_ms|$_now|$_epping|$_tunping|$_loss|$_seen|$_node|$_loc"
		case "$_status" in VALID) _valid=$((_valid+1));; REACHABLE_*) _reachable=$((_reachable+1));; *) _failed=$((_failed+1));; esac
		echo "[tgroutes] $_source: $_status reason=$_reason http=$_http latency_ms=$_ms${_detail:+ detail=$_detail}"
		[ "$_kind" = warp ] && { state_write running "$_idx" "$_total" "$_label · $_target" cleanup "$_valid" "$_reachable" "$_failed" "$_started"; stop_scan_socks; }
	done < "$SCAN_INPUT"
	stop_scan_socks
	state_write done "$_total" "$_total" "" done "$_valid" "$_reachable" "$_failed" "$_started"
	echo "[tgroutes] done: valid=$_valid reachable_nonvalid=$_reachable failed=$_failed total=$_total"
	rm -f "$SCAN_PID" "$SCAN_INPUT" 2>/dev/null
}

method_telegram_scan_start() {
	read -r _in 2>/dev/null
	command -v curl >/dev/null 2>&1 || { printf '{"ok":false,"reason":"curl_missing"}\n'; return; }
	command -v jq >/dev/null 2>&1 || { printf '{"ok":false,"reason":"jq_missing"}\n'; return; }
	command -v ubus >/dev/null 2>&1 || { printf '{"ok":false,"reason":"ubus_missing"}\n'; return; }
	pid_alive_file "$SCAN_PID" && { printf '{"ok":false,"reason":"already_running"}\n'; return; }
	pid_alive_file "$RUNTIME_PID_FILE" && { printf '{"ok":false,"reason":"runtime_socks_running"}\n'; return; }
	pid_alive_file "$RESCUE_PID_FILE" && { printf '{"ok":false,"reason":"rescue_socks_running"}\n'; return; }
	pid_alive_file "$ACTION_PID_FILE" && { printf '{"ok":false,"reason":"warpscout_action_running"}\n'; return; }
	_token=$(uci -q get podkop_bot.settings.bot_token 2>/dev/null)
	[ -n "$_token" ] || { printf '{"ok":false,"reason":"bot_token_missing"}\n'; return; }
	_port=$(cfg_get socks_port); case "$_port" in ''|*[!0-9]*) _port=18191;; esac
	[ "$_port" -ge 1024 ] 2>/dev/null && [ "$_port" -le 65535 ] 2>/dev/null || { printf '{"ok":false,"reason":"bad_port"}\n'; return; }
	_proto=$(cfg_get protocol); case "$_proto" in wg|awg|masque|masque-h2) :;; *) _proto=awg;; esac
	_total=$(build_input) || { printf '{"ok":false,"reason":"no_routes"}\n'; return; }
	: > "$SCAN_LOG"; : > "$SCAN_RESULTS"; _started=$(date +%s 2>/dev/null || echo 0)
	state_write running 0 "$_total" "" queued 0 0 0 "$_started"
	run_worker "$_total" "$_port" "$_proto" "$_token" "$_started" >> "$SCAN_LOG" 2>&1 &
	_pid=$!; printf '%s\n' "$_pid" > "$SCAN_PID"
	printf '{"ok":true,"pid":%s,"total":%s}\n' "$_pid" "$_total"
}

method_telegram_scan_status() {
	read -r _in 2>/dev/null
	_state=$(state_get state); [ -n "$_state" ] || _state=idle
	_cur=$(state_get current); [ -n "$_cur" ] || _cur=0; _total=$(state_get total); [ -n "$_total" ] || _total=0
	_route=$(state_get endpoint); _phase=$(state_get phase); _valid=$(state_get passed); [ -n "$_valid" ] || _valid=0
	_reachable=$(state_get reachable); [ -n "$_reachable" ] || _reachable=0; _failed=$(state_get failed); [ -n "$_failed" ] || _failed=0
	_started=$(state_get started_at); [ -n "$_started" ] || _started=0; _updated=$(state_get updated_at); [ -n "$_updated" ] || _updated=0
	_running=false; pid_alive_file "$SCAN_PID" && _running=true
	if [ "$_state" = running ] && [ "$_running" = false ]; then _state=stale; fi
	printf '{"ok":true,"state":%s,"running":%s,"current":%s,"total":%s,"endpoint":%s,"phase":%s,"passed":%s,"reachable":%s,"failed":%s,"started_at":%s,"updated_at":%s}\n' \
		"$(json_str "$_state")" "$_running" "$_cur" "$_total" "$(json_str "$_route")" "$(json_str "$_phase")" "$_valid" "$_reachable" "$_failed" "$_started" "$_updated"
}

method_telegram_scan_results() {
	read -r _in 2>/dev/null
	[ -s "$SCAN_RESULTS" ] || { printf '{"ok":true,"items":[]}\n'; return; }
	_items=$(jq -Rn '[inputs | split("|") | select(length >= 15) | {
		provider:.[0], source_id:.[1], label:.[2], endpoint:.[3], status:.[4], reason:.[5], http:.[6], latency_ms:(.[7]|tonumber? // 0), checked_at:(.[8]|tonumber? // 0),
		endpoint_ping:.[9], tunnel_ping:.[10], loss:.[11], seen_as:.[12], node:.[13], node_location:.[14]
	}] | sort_by((if .status=="VALID" then 0 elif (.status|startswith("REACHABLE_")) then 1 else 2 end), (if .provider=="proxy" then 0 else 1 end), (.loss|gsub("%";"")|tonumber? // 999999), .latency_ms, (.tunnel_ping|gsub("[^0-9.]";"")|tonumber? // 999999))' "$SCAN_RESULTS" 2>/dev/null)
	[ -n "$_items" ] || _items='[]'; printf '{"ok":true,"items":%s}\n' "$_items"
}

method_telegram_scan_cancel() {
	read -r _in 2>/dev/null
	if _p=$(pid_from_file "$SCAN_PID"); then kill "$_p" 2>/dev/null || true; fi
	stop_scan_socks
	_cur=$(state_get current); _total=$(state_get total); _route=$(state_get endpoint); _valid=$(state_get passed); _reachable=$(state_get reachable); _failed=$(state_get failed); _started=$(state_get started_at)
	state_write cancelled "${_cur:-0}" "${_total:-0}" "$_route" cancelled "${_valid:-0}" "${_reachable:-0}" "${_failed:-0}" "${_started:-0}"
	rm -f "$SCAN_PID" "$SCAN_INPUT" 2>/dev/null
	printf '{"ok":true,"state":"cancelled"}\n'
}

method_telegram_scan_log() {
	read -r _in 2>/dev/null
	_off=$(printf '%s' "$_in" | sed -n 's/.*"offset":\([0-9][0-9]*\).*/\1/p'); [ -n "$_off" ] || _off=0
	_size=$(wc -c < "$SCAN_LOG" 2>/dev/null | tr -d ' '); [ -n "$_size" ] || _size=0; [ "$_off" -le "$_size" ] 2>/dev/null || _off=0
	_bytes=$((_size-_off)); [ "$_bytes" -gt 32768 ] 2>/dev/null && _bytes=32768
	if [ "$_bytes" -gt 0 ] 2>/dev/null; then _chunk=$(tail -c +$((_off+1)) "$SCAN_LOG" 2>/dev/null | head -c "$_bytes" | jq -Rs . 2>/dev/null); [ -n "$_chunk" ] || _chunk='""'; else _chunk='""'; fi
	printf '{"ok":true,"chunk":%s,"offset":%s}\n' "$_chunk" "$((_off+_bytes))"
}

case "$1" in
	list) echo '{ "telegram_scan_start": {}, "telegram_scan_status": {}, "telegram_scan_results": {}, "telegram_scan_cancel": {}, "telegram_scan_log": { "offset": 0 } }' ;;
	call)
		case "$2" in
			telegram_scan_start) method_telegram_scan_start;; telegram_scan_status) method_telegram_scan_status;; telegram_scan_results) method_telegram_scan_results;; telegram_scan_cancel) method_telegram_scan_cancel;; telegram_scan_log) method_telegram_scan_log;;
			*) echo '{"error":"unknown method"}'; exit 1;;
		esac;;
	*) echo '{"error":"unknown command"}'; exit 1;;
esac
