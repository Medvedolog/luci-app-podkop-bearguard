@@ -855,13 +846,47 @@
 PODKOP_UPDATE_LOG="/tmp/podkop_core_update.log"
 _RESOLV_STATE="/tmp/podkop_bot_resolv.state"
 
-# Fetch a URL with the same practical fallover used by the bot: direct IPv4,
-# primary Mixed Proxy, configured fallback proxies, then custom_proxy. The
-# selected route is returned in _CORE_FETCH_ROUTE for logs/UI diagnostics.
+# Export Bearhole proxy variables only in a child/subshell that is about to run
+# package-manager or installer commands. rpcd itself must not retain them across
+# later ubus calls. apk-tools consumes HTTP(S)_PROXY from its process environment.
+_bearhole_export_env() {
+	[ "$(uci -q get podkop_bearhole.main.enabled 2>/dev/null)" = "1" ] || return 1
+	_bh_gateway="http://127.0.0.1:1066"
+	export http_proxy="$_bh_gateway" https_proxy="$_bh_gateway"
+	export HTTP_PROXY="$_bh_gateway" HTTPS_PROXY="$_bh_gateway"
+	export all_proxy="$_bh_gateway" ALL_PROXY="$_bh_gateway"
+	export no_proxy="127.0.0.1,localhost,::1" NO_PROXY="127.0.0.1,localhost,::1"
+	return 0
+}
+
+# Fetch a URL through the same route selector used by system recovery. When
+# OpenWrt Bearhole is enabled, the local gateway is the single routing source of
+# truth: do not re-implement its route order here. When Bearhole is disabled,
+# preserve the legacy bot fallover (direct -> tier1 -> fallback -> custom).
+#
+# Every curl call uses -q explicitly. Bearhole writes /root/.curlrc while it is
+# active; without -q a supposedly "direct" diagnostic silently inherits that
+# proxy and reports a false route label. The selected route is returned in
+# _CORE_FETCH_ROUTE for logs/UI diagnostics.
 _core_fetch() {
 	_url="$1"; _dest="$2"; _CORE_FETCH_ROUTE=""
 	rm -f "$_dest" 2>/dev/null
-	if curl -4 -fsSL --connect-timeout 8 --max-time 60 -o "$_dest" "$_url" 2>/dev/null; then
+
+	_bh_enabled=$(uci -q get podkop_bearhole.main.enabled 2>/dev/null)
+	if [ "$_bh_enabled" = "1" ]; then
+		_bh_gateway="http://127.0.0.1:1066"
+		if curl -q -4 -fsSL --proxy "$_bh_gateway" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
+			_bh_route=$(cut -d'|' -f1 /tmp/podkop_bot/bearhole/current 2>/dev/null | head -n1)
+			[ -n "$_bh_route" ] || _bh_route="gateway"
+			_CORE_FETCH_ROUTE="bearhole:$_bh_route"
+			return 0
+		fi
+		rm -f "$_dest" 2>/dev/null
+		_CORE_FETCH_ROUTE="bearhole:unavailable"
+		return 1
+	fi
+
+	if curl -q -4 -fsSL --proxy '' --connect-timeout 8 --max-time 60 -o "$_dest" "$_url" 2>/dev/null; then
 		_CORE_FETCH_ROUTE="direct"; return 0
 	fi
 
@@ -874,7 +899,7 @@
 		_port=$(uci -q get "$_pkg.$_sec.mixed_proxy_port" 2>/dev/null); [ -z "$_port" ] && _port="2080"
 		_ip=$(_resolve_proxy_ip "$_port")
 		_proxy="socks5h://$_ip:$_port"
-		if curl -fsSL --proxy "$_proxy" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
+		if curl -q -fsSL --proxy "$_proxy" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
 			_CORE_FETCH_ROUTE="tier1 $_proxy"; return 0
 		fi
 	fi
@@ -882,14 +907,14 @@
 	for _proxy in $(uci -q get podkop_bot.settings.fallback_socks 2>/dev/null); do
 		_proxy=${_proxy%%#*}
 		[ -n "$_proxy" ] || continue
-		if curl -fsSL --proxy "$_proxy" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
+		if curl -q -fsSL --proxy "$_proxy" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
 			_CORE_FETCH_ROUTE="fallback proxy"; return 0
 		fi
 	done
 
 	_proxy=$(uci -q get podkop_bot.settings.custom_proxy 2>/dev/null)
 	_proxy=${_proxy%%#*}
-	if [ -n "$_proxy" ] && curl -fsSL --proxy "$_proxy" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
+	if [ -n "$_proxy" ] && curl -q -fsSL --proxy "$_proxy" --connect-timeout 8 --max-time 90 -o "$_dest" "$_url" 2>/dev/null; then
 		_CORE_FETCH_ROUTE="custom proxy"; return 0
 	fi
 
@@ -897,16 +922,24 @@
