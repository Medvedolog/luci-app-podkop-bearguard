 }
 
-# Reachability pre-flight. Package feeds must be reachable directly because
-# opkg/apk do not inherit the bot's curl proxy chain. GitHub raw may be reached
-# either directly or through the configured fallback chain used for the actual
-# install.sh download.
+# Reachability pre-flight for an actual core update. With Bearhole enabled both
+# checks go through the gateway, matching apk/opkg and install.sh. With Bearhole
+# disabled, the OpenWrt feed stays a real direct check while GitHub uses the
+# legacy bot fallover above. Keep the return string exactly "ok" for callers.
 _pkg_net_check() {
-	curl -4 -sf -o /dev/null --connect-timeout 5 --max-time 8 "https://downloads.openwrt.org/" 2>/dev/null; _feed_rc=$?
